DISCORD_USER_TOKEN=
TARGET_CHANNELS=
DROP_BOT_ID=
WISHLIST_EVALUATOR_ID=1380936713639166082

# Writable directory for the state file and single-instance lock.
# Set this to Wispbyte's persistent storage path if one is provided.
DATA_DIR=.

# web (default, self-consistent Chrome fingerprint) or desktop (Electron)
CLIENT_PLATFORM=web
DISCORD_LOCALE=en-US
# REQUIRED on a VPS/container: tzlocal reports UTC there.
DISCORD_TIMEZONE=Europe/Berlin
DISCORD_PROXY=
FAKE_ACTIVITIES=Karuta|with cards
SKIP_CHANCE=0.02
CACHE_ALL_MEMBERS=0
CHUNK_GUILDS=1
MAX_MESSAGES=200
PYTHONUNBUFFERED=1
